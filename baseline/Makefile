# baseline/Makefile — builds the FROZEN phase-0 wrkx binary as `wrkx0`.
#
# This Makefile is baseline *tooling* (authored for the comparison harness); it
# is NOT part of the frozen phase-0 code. The frozen code is everything under
# baseline/src/, guarded by baseline/MANIFEST.sha256 (see `make baseline-verify`
# at the repo root). Do not edit baseline/src/* — see baseline/README.md.
#
# Deps (LuaJIT, OpenSSL flags) are SHARED with the parent tree:
#   - LuaJIT:  ../deps/luajit         (vendored, effectively stable)
#   - OpenSSL: ../config.mk           (generated by ../configure)
#
# Output: baseline/wrkx0  (phase-0 behaviour, for old-vs-new comparison)

CFLAGS  := -std=c99 -Wall -O2 -D_REENTRANT
LIBS    := -lpthread -lm -lcrypto -lssl

# The frozen 505cd14 src/config.h does NOT #include <sched.h> on Linux (that fix
# postdates this snapshot), so cpu_set_t — used by units.h's `struct aff_set` —
# is undefined and the baseline fails to compile on glibc. The frozen src can't
# be edited (MANIFEST guard); supply the type from the build tooling instead.
# macOS uses config.h's own non-Linux cpu_set_t stub and needs nothing here.
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
CFLAGS  += -D_GNU_SOURCE -include sched.h
endif

# OpenSSL include/lib flags generated by the parent ./configure.
-include ../config.mk

SRC  := wrk.c net.c ssl.c aprintf.c stats.c script.c units.c \
        ae.c zmalloc.c http_parser.c tinymt64.c hdr_histogram.c
BIN  := wrkx0

SDIR := src
ODIR := obj
OBJ  := $(patsubst %.c,$(ODIR)/%.o,$(SRC)) $(ODIR)/bytecode.o

# Shared LuaJIT from the parent tree (not duplicated into baseline/).
LDIR     = ../deps/luajit/src
LIBS    := -lluajit $(LIBS)
CFLAGS  += -I$(LDIR)
LDFLAGS += -L$(LDIR)

all: $(BIN)

clean:
	$(RM) $(BIN)
	$(RM) -r $(ODIR)

$(BIN): $(OBJ)
	@echo LINK $(BIN)
	@$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

$(OBJ): $(SDIR)/config.h Makefile $(LDIR)/libluajit.a | $(ODIR)

$(ODIR):
	@mkdir -p $@

# Note: depends on libluajit.a so `./luajit` exists before the bytecode step
# (the phase-0 Makefile had a latent ordering bug here; the frozen *code* is
# unchanged — this is build tooling).
$(ODIR)/bytecode.o: $(SDIR)/wrk.lua $(LDIR)/libluajit.a | $(ODIR)
	@echo LUAJIT $<
	@$(SHELL) -c 'cd $(LDIR) && ./luajit -b $(CURDIR)/$< $(CURDIR)/$@'

$(ODIR)/%.o : $(SDIR)/%.c
	@echo CC $<
	@$(CC) $(CFLAGS) -c -o $@ $<

$(LDIR)/libluajit.a:
	@echo Building shared LuaJIT...
	@$(MAKE) -C $(LDIR) BUILDMODE=static

.PHONY: all clean
