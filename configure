#!/usr/bin/env sh
# configure — detect platform and write config.mk for wrkx
set -e

CONFIG_MK="config.mk"

die() { echo "configure: error: $*" >&2; exit 1; }
info() { echo "configure: $*"; }

# -- Detect OS -----------------------------------------------------------------
TARGET=$(uname -s | tr '[:upper:]' '[:lower:]' 2>/dev/null || echo unknown)
info "detected platform: $TARGET"

# -- Parse optional args -------------------------------------------------------
QUICKJS_ENABLED=0
for arg in "$@"; do
  case "$arg" in
    --with-openssl=*) OPENSSL_PREFIX="${arg#*=}" ;;
    --prefix=*)       PREFIX="${arg#*=}" ;;
    --with-quickjs)   QUICKJS_ENABLED=1 ;;
    --help)
      echo "Usage: ./configure [--with-openssl=PATH] [--prefix=PATH] [--with-quickjs]"
      exit 0 ;;
    *) die "unknown option: $arg" ;;
  esac
done

# -- Start writing config.mk ---------------------------------------------------
cat > "$CONFIG_MK" <<EOF
# Auto-generated by ./configure — do not edit by hand.
# Re-run ./configure to regenerate.

TARGET := $TARGET
EOF

# -- Platform-specific detection -----------------------------------------------
case "$TARGET" in
  darwin)
    # Deployment target — needed both for the main build and the LuaJIT
    # bcsave step (which reads it to emit LC_BUILD_VERSION in bytecode.o).
    DEPL=$(sw_vers -productVersion 2>/dev/null || echo "13.0")
    info "macOS deployment target: $DEPL"

    # OpenSSL — Homebrew on Apple Silicon (/opt/homebrew) or Intel (/usr/local)
    if [ -z "$OPENSSL_PREFIX" ]; then
      if command -v brew >/dev/null 2>&1; then
        OPENSSL_PREFIX=$(brew --prefix openssl 2>/dev/null) \
          || die "brew --prefix openssl failed; install openssl via Homebrew or pass --with-openssl=PATH"
      elif [ -d /usr/local/opt/openssl ]; then
        OPENSSL_PREFIX=/usr/local/opt/openssl
      else
        die "OpenSSL not found; install via 'brew install openssl' or pass --with-openssl=PATH"
      fi
    fi
    info "OpenSSL prefix: $OPENSSL_PREFIX"
    [ -f "$OPENSSL_PREFIX/include/openssl/ssl.h" ] \
      || die "openssl/ssl.h not found under $OPENSSL_PREFIX"

    cat >> "$CONFIG_MK" <<EOF

export MACOSX_DEPLOYMENT_TARGET := $DEPL
CFLAGS  += -I$OPENSSL_PREFIX/include
LIBS    += -L$OPENSSL_PREFIX/lib
EOF
    ;;

  linux)
    # OpenSSL via pkg-config, then common system paths
    if [ -z "$OPENSSL_PREFIX" ]; then
      if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openssl 2>/dev/null; then
        SSL_CFLAGS=$(pkg-config --cflags openssl)
        SSL_LIBS=$(pkg-config --libs-only-L openssl)
        info "OpenSSL via pkg-config"
      elif [ -d /usr/include/openssl ]; then
        SSL_CFLAGS=""
        SSL_LIBS=""
        info "OpenSSL at system default paths"
      else
        die "OpenSSL not found; install libssl-dev or pass --with-openssl=PATH"
      fi
    else
      SSL_CFLAGS="-I$OPENSSL_PREFIX/include"
      SSL_LIBS="-L$OPENSSL_PREFIX/lib"
      info "OpenSSL prefix: $OPENSSL_PREFIX"
    fi

    cat >> "$CONFIG_MK" <<EOF

CFLAGS  += -D_GNU_SOURCE $SSL_CFLAGS
LIBS    += -ldl $SSL_LIBS
LDFLAGS += -Wl,-E
EOF
    ;;

  freebsd)
    cat >> "$CONFIG_MK" <<EOF

CFLAGS  += -D_DECLARE_C99_LDBL_MATH
LDFLAGS += -Wl,-E
EOF
    ;;

  sunos)
    cat >> "$CONFIG_MK" <<EOF

CFLAGS += -D_PTHREADS -D_POSIX_C_SOURCE=200112L
LIBS   += -lsocket
EOF
    ;;

  *)
    die "unsupported platform: $TARGET"
    ;;
esac

# -- QuickJS opt-in -----------------------------------------------------------
cat >> "$CONFIG_MK" <<EOF

QUICKJS_ENABLED := $QUICKJS_ENABLED
EOF
if [ "$QUICKJS_ENABLED" = "1" ]; then
  info "QuickJS enabled (deps/quickjs)"
fi

info "wrote $CONFIG_MK"
echo ""
echo "  Run 'make' to build."
